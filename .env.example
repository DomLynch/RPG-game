# Public browser ingest key, not a Sentry management token. Set in .env.production.local.
VITE_SENTRY_DSN=
# scripts/deploy.sh injects the committed revision automatically.
VITE_SENTRY_RELEASE=

# Optional: enable Google account controls inside Field Journal. Dedicated Frankendom project only.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
