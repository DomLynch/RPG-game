#!/bin/sh
# Trunk discipline (owner-enforced 2026-09-19, rule in AGENTS.md): the live trunk lives ONLY in the lead
# checkout. A lane worktree (~/Developer/frankendom-*) that switches onto the trunk branch is reverted to
# its previous branch immediately, with a loud note. Instant and never fails — the git op itself is untouched.
TRUNK="codex/01a09a76/task-1"
if [ "$3" = "1" ] && [ "$(git rev-parse --abbrev-ref HEAD 2>/dev/null)" = "$TRUNK" ]; then
  case "$(pwd -P)/" in
    "$HOME/Developer/frankendom-"*)
      echo "TRUNK DISCIPLINE (AGENTS.md): lane worktrees never check out $TRUNK — reverting to your previous branch." >&2
      git checkout -q - 2>/dev/null || git checkout -q --detach ;;
  esac
fi
# Auto Codegraph sync — must NEVER fail or block the git operation.
if command -v codegraph >/dev/null 2>&1; then
  (
    if [ -d .codegraph ]; then codegraph sync -q
    else codegraph init >/dev/null 2>&1
    fi
    GITDIR=$(git rev-parse --git-dir 2>/dev/null)
    [ -n "$GITDIR" ] && echo "$(date '+%F %T') $0 ran" >> "$GITDIR/codegraph-hook.log" 2>/dev/null
  ) &
fi
exit 0
