{
  "about": "Region 1 economy and progression content as rows (issue #2554 group D): the foes and town people (character-definition), the encounters, the Bounties, their twist flags, the rifts, who pays which progression row and how each boss table is rolled. Each row is in the contracts' own shape (the records content.ts used to build in code); content.ts only loads them. A new foe, bounty or rift is one row here.",
  "foes": [
    {"kind":"character-definition","schemaVersion":1,"id":"character:mere-mother","name":"Grendel's Mother","lore":{"source":"Beowulf (Old English poem, Cotton Vitellius A.xv)","summary":"In the old poem she came up out of a haunted mere to avenge her son and was cut down in her own hall beneath the water. The Fracture set her mere on the Ash Frontier, and she drowns every boat put on it."},"faction":null,"essential":false,"relationships":[],"questRoles":[],"presentations":[{"id":"default","asset":"characters/mere-mother.glb"}],"encounterForms":[{"id":"public","opponent":"witch","level":4,"encounter":"encounter:mere-mother"}],"routine":[]},
    {"kind":"character-definition","schemaVersion":1,"id":"character:hrungnir","name":"Hrungnir","lore":{"source":"Snorri Sturluson, Prose Edda, Skaldskaparmal, c. 1220","summary":"A giant of stone with a heart of stone. Here he stands on the displaced shrine in the Cinder Fields and takes any challenge put to him."},"faction":null,"essential":false,"relationships":[],"questRoles":[],"presentations":[{"id":"default","asset":"characters/hrungnir.glb"}],"encounterForms":[{"id":"bounty","opponent":"knight","level":3,"encounter":"encounter:bounty-hrungnir"}],"routine":[]},
    {"kind":"character-definition","schemaVersion":1,"id":"character:peg-powler","name":"Peg Powler","lore":{"source":"Tees folklore; W. Henderson, Notes on the Folk-Lore of the Northern Counties, 1866","summary":"The green-haired hag of the river, who drags the careless under. In the Black Mere she keeps to the reeds and runs when the fight turns."},"faction":null,"essential":false,"relationships":[],"questRoles":[],"presentations":[{"id":"default","asset":"characters/peg-powler.glb"}],"encounterForms":[{"id":"bounty","opponent":"witch","level":3,"encounter":"encounter:bounty-peg-powler"}],"routine":[]},
    {"kind":"character-definition","schemaVersion":1,"id":"character:court-thrall","name":"Court thrall","lore":{"source":"original","summary":"A bonded fighter of the Blood Court, sent out along the Charnel Road to take tolls in its name."},"faction":"faction:blood-court","essential":false,"relationships":[],"questRoles":[],"presentations":[{"id":"default","asset":"characters/court-thrall.glb"}],"encounterForms":[{"id":"l12","opponent":"pitborn","level":3,"encounter":"encounter:bounty-toll"},{"id":"l13","opponent":"pitborn","level":13,"encounter":null}],"routine":[]},
    {"kind":"character-definition","schemaVersion":1,"id":"character:cinder-scavenger","name":"Cinder scavenger","lore":{"source":"original","summary":"Picks the ash pits for iron and anything else the Fracture left lying."},"faction":null,"essential":false,"relationships":[],"questRoles":[],"presentations":[{"id":"default","asset":"characters/cinder-scavenger.glb"}],"encounterForms":[{"id":"mob","opponent":"goblin","level":1,"encounter":null}],"routine":[]},
    {"kind":"character-definition","schemaVersion":1,"id":"character:pit-goblin","name":"Pit goblin","lore":{"source":"original","summary":"A goblin of the Pit in the armour the Pit gave him, camped at the edge of the Frontier where a fighter can find him."},"faction":null,"essential":false,"relationships":[],"questRoles":[],"presentations":[{"id":"default","asset":"characters/pit-goblin.glb"}],"encounterForms":[{"id":"mob","opponent":"goblin","level":1,"encounter":null}],"routine":[]},
    {"kind":"character-definition","schemaVersion":1,"id":"character:ash-wolf","name":"Ash wolf","lore":{"source":"original","summary":"Lean and ash-coated, it hunts the road verge where the Fracture left the herds nothing."},"faction":null,"essential":false,"relationships":[],"questRoles":[],"presentations":[{"id":"default","asset":"characters/ash-wolf.glb"}],"encounterForms":[{"id":"mob","opponent":"wolf","level":1,"encounter":null}],"routine":[]},
    {"kind":"character-definition","schemaVersion":1,"id":"character:ember-wolf","name":"Ember wolf","lore":{"source":"original","summary":"Its coat has burned down to the colour of a banked fire, and it hunts the Reach in a pack of two or three."},"faction":null,"essential":false,"relationships":[],"questRoles":[],"presentations":[{"id":"default","asset":"characters/ember-wolf.glb"}],"encounterForms":[{"id":"mob","opponent":"wolf","level":1,"encounter":null}],"routine":[]},
    {"kind":"character-definition","schemaVersion":1,"id":"character:cinder-bear","name":"Cinder bear","lore":{"source":"original","summary":"Heavy and soot-matted, it came down off the burnt moor when the herds went and takes what it finds."},"faction":null,"essential":false,"relationships":[],"questRoles":[],"presentations":[{"id":"default","asset":"characters/cinder-bear.glb"}],"encounterForms":[{"id":"mob","opponent":"bear","level":1,"encounter":null}],"routine":[]},
    {"kind":"character-definition","schemaVersion":1,"id":"character:ash-boar","name":"Ash boar","lore":{"source":"original","summary":"Tusked and ash-streaked, it roots the verge of the hold road for what the Fracture left in the ground."},"faction":null,"essential":false,"relationships":[],"questRoles":[],"presentations":[{"id":"default","asset":"characters/ash-boar.glb"}],"encounterForms":[{"id":"mob","opponent":"boar","level":1,"encounter":null}],"routine":[]},
    {"kind":"character-definition","schemaVersion":1,"id":"character:giant-salamander","name":"Giant salamander","lore":{"source":"original","summary":"A fire-coloured lizard as long as a man, it came up from the cold springs of the Black Mere and sleeps wherever the reeds are warm."},"faction":null,"essential":false,"relationships":[],"questRoles":[],"presentations":[{"id":"default","asset":"characters/giant-salamander.glb"}],"encounterForms":[{"id":"mob","opponent":"giant-salamander","level":1,"encounter":null}],"routine":[]},
    {"kind":"character-definition","schemaVersion":1,"id":"character:cave-troll","name":"Cave troll","lore":{"source":"original","summary":"Three times a goblin's height and grey as the cave it came out of, it holds the ash pits and everything the goblins have stacked there."},"faction":null,"essential":false,"relationships":[],"questRoles":[],"presentations":[{"id":"default","asset":"characters/cave-troll.glb"}],"encounterForms":[{"id":"mob","opponent":"cave-troll","level":3,"encounter":null}],"routine":[]},
    {"kind":"character-definition","schemaVersion":1,"id":"character:mere-brood","name":"Mere brood","lore":{"source":"original","summary":"One of the mere's spawn, out of the reeds and hungry."},"faction":null,"essential":false,"relationships":[],"questRoles":[],"presentations":[{"id":"default","asset":"characters/mere-brood.glb"}],"encounterForms":[{"id":"mob","opponent":"goblin","level":1,"encounter":"encounter:mere-mother"}],"routine":[]},
    {"kind":"character-definition","schemaVersion":1,"id":"character:ruin-ghoul","name":"Ruin ghoul","lore":{"source":"original","summary":"A starved servant of the Blood Court ruin."},"faction":"faction:blood-court","essential":false,"relationships":[],"questRoles":[],"presentations":[{"id":"default","asset":"characters/ruin-ghoul.glb"}],"encounterForms":[{"id":"mob","opponent":"goblin","level":1,"encounter":null}],"routine":[]},
    {"kind":"character-definition","schemaVersion":1,"id":"character:lambton-worm","name":"The Lambton Worm","lore":{"source":"County Durham folklore; R. Surtees, History of Durham, vol. 2, 1820","summary":"The worm a young heir threw down a well grew until it wrapped a hill. Where the sky splits over the Frontier, it comes up through the rift."},"faction":null,"essential":false,"relationships":[],"questRoles":[],"presentations":[{"id":"default","asset":"characters/lambton-worm.glb"}],"encounterForms":[{"id":"rift","opponent":"minotaur","level":17,"encounter":"encounter:rift-worm"}],"routine":[]},
    {"kind":"character-definition","schemaVersion":1,"id":"character:rift-spawn","name":"Rift spawn","lore":{"source":"original","summary":"Something that came through the split sky ahead of the worm."},"faction":null,"essential":false,"relationships":[],"questRoles":[],"presentations":[{"id":"default","asset":"characters/rift-spawn.glb"}],"encounterForms":[{"id":"guardian","opponent":"goblin","level":15,"encounter":"encounter:rift-worm"}],"routine":[]}
