# The Origins writer: verifies a player's Supabase token and commits their save through origins_commit (origins/server). Not enabled until #1449 is applied.
[Unit]
Description=Frankendom Origins writer
After=network-online.target

[Service]
WorkingDirectory=/opt/frankendom-verifier/current
EnvironmentFile=/etc/frankendom/origins-writer.env
ExecStart=/usr/bin/env node scripts/origins-writer.mjs
Restart=on-failure
RestartSec=3
StandardOutput=append:/var/log/frankendom-origins-writer.log
StandardError=append:/var/log/frankendom-origins-writer.log

[Install]
WantedBy=multi-user.target
