# The live-PvP relay (scripts/duel-relay.mjs): WebRTC signalling plus the fallback packet path, on 127.0.0.1:8787 behind nginx.
# Frankendom comes first on this shared box (Lead 2026-09-29): a higher CPU weight and I/O priority than the default slice, and a
# slightly raised scheduling priority, so a busy neighbour cannot starve a live duel. It never reads or writes anything but its socket.
[Unit]
Description=Frankendom duel relay
After=network-online.target

[Service]
Type=simple
WorkingDirectory=/opt/frankendom-relay/current
Environment=DUEL_RELAY_PORT=8787
ExecStart=/usr/bin/env node scripts/duel-relay.mjs
Restart=always
RestartSec=2
Nice=-5
CPUWeight=500
IOWeight=500
MemoryMax=256M
DynamicUser=yes
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
StandardOutput=append:/var/log/frankendom-duel-relay.log
StandardError=append:/var/log/frankendom-duel-relay.log

[Install]
WantedBy=multi-user.target
