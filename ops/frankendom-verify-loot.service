# Settles pending ladder-win loot claims against the deployed rules (scripts/verify-loot.mjs) — one sweep per timer tick.
[Unit]
Description=Frankendom loot-claim replay verifier
After=network-online.target

[Service]
Type=oneshot
WorkingDirectory=/opt/frankendom-verifier/current
EnvironmentFile=/etc/frankendom/verifier.env
ExecStart=/usr/bin/env node scripts/verify-loot.mjs
StandardOutput=append:/var/log/frankendom-verify-loot.log
StandardError=append:/var/log/frankendom-verify-loot.log
