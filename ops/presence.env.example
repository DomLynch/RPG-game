# Template for /etc/frankendom/presence.env (root 0600). ops/install-presence.sh writes the real file on the first install, generating PRESENCE_INTERNAL_KEY on the box; this copy has NO
# secrets and is documentation only. SUPABASE_URL and SUPABASE_ANON_KEY are the project's PUBLIC url and anon key (the ones the page ships), used to check a player's token.
ORIGINS_PRESENCE=0            # the flag: 1 turns the service on (Lead + Strategy GO); 0 leaves it installed and stopped
SUPABASE_URL=https://<project>.supabase.co
SUPABASE_ANON_KEY=<the public anon key>
PRESENCE_HOST=127.0.0.1       # never anything but loopback
PRESENCE_PORT=8788
PRESENCE_INTERNAL_KEY=<generated on the box: openssl rand -hex 32; the writer holds the same value to call /internal/where>
